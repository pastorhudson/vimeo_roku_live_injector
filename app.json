{
  "name": "your-flask-app",
  "description": "Roku Flask application running on Dokku",
  "keywords": ["dokku", "flask", "python"],
  "env": {
    "LANG": {
      "value": "en_US.UTF-8"
    },
    "LC_ALL": {
      "value": "en_US.UTF-8"
    },
    "FLASK_ENV": {
      "description": "Flask environment",
      "value": "production"
    },
    "PYTHONUNBUFFERED": {
      "value": "1"
    },
    "WEB_CONCURRENCY": {
      "description": "Gunicorn worker count",
      "value": "3"
    }
  }
}
